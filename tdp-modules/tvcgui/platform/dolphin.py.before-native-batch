def addr_in_ram(a):
    if a is None:
        return False

    try:
        a = int(a)
    except Exception:
        return False

    return (
        MEM1_LO <= a < MEM1_HI
        or MEM2_LO <= a < MEM2_HI
    )


def _clamp_read_range(addr, size):
    try:
        addr = int(addr)
        size = int(size)
    except Exception:
        return False, 0, 0

    if size <= 0:
        return False, addr, 0

    if MEM1_LO <= addr < MEM1_HI:
        hi = min(addr + size, MEM1_HI)
        return True, addr, hi - addr

    if MEM2_LO <= addr < MEM2_HI:
        hi = min(addr + size, MEM2_HI)
        return True, addr, hi - addr

    return False, addr, 0


# ============================================================
# READS
# ============================================================

def rbytes(addr, size):
    ok, base, span = _clamp_read_range(addr, size)

    if not ok or span <= 0:
        return b""

    if not _connect():
        return b""

    host = _guest_to_host(base)

    if host is None:
        return b""

    data = _rpm(host, span)

    if data:
        return data

    # One reconnect attempt handles a restarted ModernGekko process.
    if _connect(force=True):
        host = _guest_to_host(base)

        if host is not None:
            return _rpm(host, span)

    return b""


def rd8(addr):
    if not addr_in_ram(addr):
        return None

    data = rbytes(addr, 1)

    if len(data) != 1:
        return None

    return data[0]


def rd32(addr):
    if not addr_in_ram(addr):
        return None

    data = rbytes(addr, 4)

    if len(data) != 4:
        return None

    return struct.unpack(">I", data)[0]


def rdf32(addr):
    if not addr_in_ram(addr):
        return None

    data = rbytes(addr, 4)

    if len(data) != 4:
        return None

    value = struct.unpack(">f", data)[0]

    if not math.isfinite(value) or abs(value) > 1e8:
        return None

    return value


# ============================================================
# DATA WRITES
# ============================================================

def wbytes(addr, data, *, bypass_quarantine: bool = False):
    if not addr_in_ram(addr):
        return False

    try:
        payload = bytes(data)
    except Exception:
        return False

    if not payload:
        return False

    with _WRITE_QUARANTINE_LOCK:
        quarantined = bool(_WRITE_QUARANTINE_ACTIVE)

    if quarantined and not bypass_quarantine:
        _trace_quarantined_write(int(addr), payload)
        return False

    if not _connect():
        return False

    host = _guest_to_host(int(addr))

    if host is None:
        return False

    if _wpm(host, payload):
        return True

    if _connect(force=True):
        host = _guest_to_host(int(addr))

        if host is not None:
            return _wpm(host, payload)

    return False


def wd8(addr, value, *, bypass_quarantine: bool = False):
    try:
        value = int(value) & 0xFF
    except Exception:
        return False

    return wbytes(
        addr,
        bytes([value]),
        bypass_quarantine=bypass_quarantine,
    )


def wd32(addr, value, *, bypass_quarantine: bool = False):
    try:
        value = int(value) & 0xFFFFFFFF
    except Exception:
        return False

    return wbytes(
        addr,
        struct.pack(">I", value),
        bypass_quarantine=bypass_quarantine,
    )


def wdf32(addr, value, *, bypass_quarantine: bool = False):
    try:
        value = float(value)

        if not math.isfinite(value):
            return False

    except Exception:
        return False

    return wbytes(
        addr,
        struct.pack(">f", value),
        bypass_quarantine=bypass_quarantine,
    )


def patch_code(addr, data, *, timeout=2.0):
    """
    Write PPC instruction bytes through ModernGekko's synchronized
    patch_code automation command.

    Unlike wbytes(), this causes the runtime to reset the emulated PPC
    instruction cache and invalidate compiled JIT code.
    """
    import os
    import time
    from pathlib import Path

    try:
        addr = int(addr)
        payload = bytes(data)
    except Exception:
        return False

    if not payload or len(payload) > 4096:
        return False

    end_addr = addr + len(payload) - 1
    if end_addr > 0xFFFFFFFF:
        return False

    if not addr_in_ram(addr) or not addr_in_ram(end_addr):
        return False

    automation_env = os.environ.get("TVC_MODERNGEKKO_AUTOMATION")

    if automation_env:
        root = Path(automation_env)
    else:
        mg_root = Path(
            os.environ.get(
                "TVC_MODERNGEKKO_ROOT",
                r"C:\Users\cce29\OneDrive\Desktop\new recomp\MG",
            )
        )
        root = mg_root / "tvc-automation"

    commands = root / "commands"
    processed = root / "processed"
    failed = root / "failed"

    try:
        commands.mkdir(parents=True, exist_ok=True)
        processed.mkdir(parents=True, exist_ok=True)
        failed.mkdir(parents=True, exist_ok=True)
    except OSError:
        return False

    token = f"{os.getpid()}_{time.time_ns()}"
    name = f"patch_code_{token}.txt"

    final_path = commands / name
    temp_path = commands / f".{name}.tmp"
    processed_path = processed / name
    failed_path = failed / name

    hex_data = " ".join(f"{b:02X}" for b in payload)

    command = (
        "command=patch_code\n"
        f"address=0x{addr:08X}\n"
        f"data={hex_data}\n"
    )

    try:
        temp_path.write_text(command, encoding="ascii", newline="\n")
        os.replace(temp_path, final_path)
    except OSError:
        try:
            temp_path.unlink(missing_ok=True)
        except Exception:
            pass
        return False

    deadline = time.monotonic() + max(0.05, float(timeout))

    while time.monotonic() < deadline:
        if processed_path.exists():
            return True

        if failed_path.exists():
            return False

        time.sleep(0.005)

    return False


def patch_code_many(writes, *, timeout=3.0):
    """
    Queue multiple JIT-safe PPC instruction patches at once.

    All command files are published before waiting, allowing ModernGekko
    to consume the batch in one automation scan instead of paying the
    polling latency once per instruction.
    """
    import os
    import time
    from pathlib import Path

    if not isinstance(writes, dict) or not writes:
        return True

    automation_env = os.environ.get("TVC_MODERNGEKKO_AUTOMATION")

    if automation_env:
        root = Path(automation_env)
    else:
        mg_root = Path(
            os.environ.get(
                "TVC_MODERNGEKKO_ROOT",
                r"C:\Users\cce29\OneDrive\Desktop\new recomp\MG",
            )
        )
        root = mg_root / "tvc-automation"

    commands = root / "commands"
    processed = root / "processed"
    failed = root / "failed"

    try:
        commands.mkdir(parents=True, exist_ok=True)
        processed.mkdir(parents=True, exist_ok=True)
        failed.mkdir(parents=True, exist_ok=True)
    except OSError:
        return False

    pending = []

    try:
        for seq, (addr, data) in enumerate(writes.items()):
            addr_i = int(addr)
            payload = bytes(data)

            if not payload or len(payload) > 4096:
                return False

            end_addr = addr_i + len(payload) - 1

            if (
                end_addr > 0xFFFFFFFF
                or not addr_in_ram(addr_i)
                or not addr_in_ram(end_addr)
            ):
                return False

            token = f"{os.getpid()}_{time.time_ns()}_{seq}"
            name = f"patch_code_batch_{token}.txt"

            final_path = commands / name
            temp_path = commands / f".{name}.tmp"

            hex_data = " ".join(f"{b:02X}" for b in payload)

            command = (
                "command=patch_code\n"
                f"address=0x{addr_i:08X}\n"
                f"data={hex_data}\n"
            )

            temp_path.write_text(
                command,
                encoding="ascii",
                newline="\n",
            )

            os.replace(temp_path, final_path)

            pending.append(
                (
                    processed / name,
                    failed / name,
                )
            )

    except Exception:
        return False

    deadline = time.monotonic() + max(0.05, float(timeout))

    while pending and time.monotonic() < deadline:
        remaining = []

        for processed_path, failed_path in pending:
            if failed_path.exists():
                return False

            if not processed_path.exists():
                remaining.append((processed_path, failed_path))

        pending = remaining

        if pending:
            time.sleep(0.005)

    return not pending
